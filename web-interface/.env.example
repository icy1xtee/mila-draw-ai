# Copy to .env (not in git) and fill in. UTF-8.
# Shared password for Mila Draw AI. Empty = anyone on the network can open it.
STUDIO_PASSWORD=
# Port on the home network. ComfyUI stays on 127.0.0.1:8188.
STUDIO_PORT=8000
# Claude model that describes pictures and turns text into a prompt (alias or full id).
STUDIO_CLAUDE_MODEL=sonnet
