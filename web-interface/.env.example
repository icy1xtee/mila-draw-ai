# Copy to .env (not in git) and fill in. UTF-8.
# Shared password for the web interface. Empty = anyone on the network can log in.
STUDIO_PASSWORD=
# Names on the login screen, comma-separated.
STUDIO_USERS=Мила,Павел
# Port on the home network. ComfyUI stays on 127.0.0.1:8188.
STUDIO_PORT=8000
# Claude model for the journal and the prompt helper (alias or full id).
STUDIO_CLAUDE_MODEL=sonnet
# Seconds of quiet in a task before Claude updates its journal.
STUDIO_JOURNAL_DELAY=90
